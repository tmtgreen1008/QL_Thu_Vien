<mxCell id="n48" value="&lt;b&gt;Tổng phải thu&lt;/b&gt;&lt;br&gt;5.000 đ" style="rounded=1;arcSize=15;whiteSpace=wrap;html=1;fillColor=#f2f4f6;strokeColor=#9aa3ad;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=10;fontColor=#000000;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="610" y="338" width="250" height="48" as="geometry"/></mxCell>
