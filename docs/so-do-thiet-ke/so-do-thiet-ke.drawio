<diagram name="Sitemap" id="page3">
<mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="860" pageHeight="960" math="0" shadow="0"><root>
<mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="n2" value="Website Thư viện" style="rounded=1;arcSize=15;whiteSpace=wrap;html=1;fillColor=#1f4e5f;strokeColor=#1f4e5f;align=center;verticalAlign=middle;fontSize=15;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="270" y="12" width="320" height="50" as="geometry"/></mxCell>
<mxCell id="n3" value="&lt;b&gt;Công khai (không cần đăng nhập)&lt;/b&gt;&lt;br&gt;&lt;br&gt;Trang chủ  /&lt;br&gt;Tra cứu sách  /Catalog&lt;br&gt;    Chi tiết sách  /Catalog/Details/{id}&lt;br&gt;Bảng giá thẻ  /Pricing&lt;br&gt;Giỏ quan tâm  /Wishlist  (Session)&lt;br&gt;Đăng ký  /Identity/Account/Register&lt;br&gt;Đăng nhập  /Identity/Account/Login&lt;br&gt;Đổi ngôn ngữ  POST /Language/Set  (Cookie)&lt;br&gt;&lt;br&gt;REST API:&lt;br&gt;    GET /api/books&lt;br&gt;    GET /api/books/{id}&lt;br&gt;    GET /api/categories" style="rounded=1;arcSize=15;whiteSpace=wrap;html=1;fillColor=#e8f1fb;strokeColor=#4a6fa5;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=12;fontColor=#000000;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="15" y="105" width="400" height="330" as="geometry"/></mxCell>
<mxCell id="n4" value="&lt;b&gt;Khách hàng (role User)&lt;/b&gt;&lt;br&gt;&lt;br&gt;Tổng quan  /My&lt;br&gt;Sách đang mượn  /My/Loans&lt;br&gt;    Gia hạn (AJAX)&lt;br&gt;Lịch sử mượn trả  /My/History&lt;br&gt;Thanh toán và nợ  /My/Payments&lt;br&gt;Hồ sơ cá nhân  /My/Profile&lt;br&gt;Đổi mật khẩu  /Identity/Account/Manage&lt;br&gt;&lt;br&gt;REST API (cần đăng nhập):&lt;br&gt;    GET /api/me/loans&lt;br&gt;    POST /api/me/loans/{id}/renew" style="rounded=1;arcSize=15;whiteSpace=wrap;html=1;fillColor=#e9f7ec;strokeColor=#3f8f55;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=12;fontColor=#000000;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="445" y="105" width="400" height="330" as="geometry"/></mxCell>
<mxCell id="n5" value="Quản trị  /Admin  (role Admin)" style="rounded=1;arcSize=15;whiteSpace=wrap;html=1;fillColor=#c25b1d;strokeColor=#c25b1d;align=center;verticalAlign=middle;fontSize=14;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="15" y="470" width="830" height="44" as="geometry"/></mxCell>
<mxCell id="n6" value="&lt;b&gt;Bảng điều khiển và Kho sách&lt;/b&gt;&lt;br&gt;&lt;br&gt;Bảng điều khiển  /Admin&lt;br&gt;Đầu sách  /Admin/Books&lt;br&gt;    Thêm, sửa, xóa, ảnh bìa&lt;br&gt;    Chi tiết và bản sao&lt;br&gt;Tác giả  /Admin/Authors&lt;br&gt;Thể loại  /Admin/Categories" style="rounded=1;arcSize=15;whiteSpace=wrap;html=1;fillColor=#fdf1e3;strokeColor=#c25b1d;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=12;fontColor=#000000;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="15" y="555" width="270" height="250" as="geometry"/></mxCell>
<mxCell id="n7" value="&lt;b&gt;Khách hàng và Mượn / Trả&lt;/b&gt;&lt;br&gt;&lt;br&gt;Khách hàng  /Admin/Members&lt;br&gt;    Chi tiết, sửa, khóa&lt;br&gt;Gói thành viên&lt;br&gt;Bán, gia hạn thẻ&lt;br&gt;Hoàn cọc, hủy thẻ&lt;br&gt;Cho mượn sách&lt;br&gt;Trả sách, sách đang mượn&lt;br&gt;Phiếu mượn (chi tiết, in)" style="rounded=1;arcSize=15;whiteSpace=wrap;html=1;fillColor=#fdf1e3;strokeColor=#c25b1d;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=12;fontColor=#000000;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="295" y="555" width="270" height="250" as="geometry"/></mxCell>
<mxCell id="n8" value="&lt;b&gt;Tiền và Báo cáo&lt;/b&gt;&lt;br&gt;&lt;br&gt;Sổ giao dịch  /Admin/Payments&lt;br&gt;    Lọc, xuất CSV&lt;br&gt;    Thu nợ, hủy giao dịch&lt;br&gt;Báo cáo  /Admin/Reports&lt;br&gt;    Doanh thu&lt;br&gt;    Sách quá hạn&lt;br&gt;    Mượn nhiều, tồn lâu&lt;br&gt;    Thẻ sắp hết hạn&lt;br&gt;    Kho sách" style="rounded=1;arcSize=15;whiteSpace=wrap;html=1;fillColor=#fdf1e3;strokeColor=#c25b1d;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fontSize=12;fontColor=#000000;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="575" y="555" width="270" height="250" as="geometry"/></mxCell>
<mxCell id="n15" value="&lt;b&gt;Ghi chú phân quyền và kỹ thuật&lt;/b&gt;&lt;br&gt;• /My cần đăng nhập role User; /Admin cần role Admin (role khác bị từ chối).&lt;br&gt;• Mọi thao tác thay đổi dữ liệu là POST kèm anti-forgery token; AJAX gửi token qua header.&lt;br&gt;• Giỏ quan tâm lưu trong Session; sách xem gần đây và ngôn ngữ lưu trong Cookie.&lt;br&gt;• Tra cứu sách và gia hạn gọi REST API bằng AJAX (jQuery), không tải lại trang." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fffbe6;strokeColor=#c9b458;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;dashed=1;fontSize=11;fontColor=#000000;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="15" y="830" width="830" height="115" as="geometry"/></mxCell>
