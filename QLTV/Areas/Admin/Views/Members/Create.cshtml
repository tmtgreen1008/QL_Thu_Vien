@model MemberFormVm
@{
    ViewData["Title"] = "Tạo hồ sơ khách";
}

<h2 class="h4 mb-3">Tạo hồ sơ khách</h2>

<form asp-action="Create" method="post" style="max-width:720px">
    <partial name="_Form" model="Model" />
    <div class="mt-4">
        <button type="submit" class="btn btn-primary">Lưu</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Hủy</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
