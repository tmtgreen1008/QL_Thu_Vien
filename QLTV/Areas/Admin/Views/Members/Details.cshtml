@model MemberDetailsVm
@using System.Globalization
@{
    var m = Model.Member;
    ViewData["Title"] = m.FullName;
    var vi = new CultureInfo("vi-VN");
    var today = DateTime.Today;
    string Money(decimal v) => v.ToString("N0", vi) + " đ";
}

<div class="d-flex justify-content-between align-items-start mb-3 flex-wrap gap-2">
    <div>
        <a asp-action="Index" class="text-decoration-none small">← Danh sách khách</a>
        <h2 class="h4 mt-1 mb-0">
            @m.FullName
            <span class="text-muted font-monospace fs-6 ms-1">@m.MemberCode</span>
            @if (m.IsLocked) { <span class="badge text-bg-danger ms-1">Đã khóa</span> }
        </h2>
    </div>
    <div class="d-flex gap-2 flex-wrap">
        <a asp-action="Edit" asp-route-id="@m.Id" class="btn btn-outline-primary">Sửa thông tin</a>
        <a asp-controller="Loans" asp-action="Create" asp-route-memberId="@m.Id" class="btn btn-primary">Cho mượn sách</a>
        <a asp-controller="Memberships" asp-action="Sell" asp-route-memberId="@m.Id" class="btn btn-success">Bán / gia hạn thẻ</a>
        <a asp-controller="Memberships" asp-action="Refund" asp-route-memberId="@m.Id" class="btn btn-outline-warning">Hoàn cọc, hủy thẻ</a>
    </div>
</div>

@if (m.IsLocked)
{
    <div class="alert alert-danger d-flex justify-content-between align-items-center">
        <div><strong>Khách đang bị khóa.</strong> Lý do: @m.LockReason</div>
        <form asp-action="Unlock" asp-route-id="@m.Id" method="post" class="m-0">
            <button type="submit" class="btn btn-sm btn-light">Mở khóa</button>
        </form>
    </div>
}

<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card h-100"><div class="card-body">
            <div class="text-muted small">Thẻ hiện tại</div>
            @if (Model.CurrentCard != null)
            {
                <div class="fw-semibold">@Model.CurrentCard.Plan?.Name</div>
                <div class="small text-muted">đến @Model.CurrentCard.EndDate.ToString("dd/MM/yyyy")</div>
                <div class="small text-muted">Mượn tối đa @Model.CurrentCard.Plan?.MaxBooks cuốn · @Model.CurrentCard.Plan?.LoanDays ngày</div>
            }
            else
            {
                <div class="text-danger">Chưa có thẻ hiệu lực</div>
            }
        </div></div>
    </div>
    <div class="col-md-3">
        <div class="card h-100"><div class="card-body">
            <div class="text-muted small">Tiền cọc đang giữ</div>
            <div class="fs-4">@Money(Model.HeldDeposit)</div>
        </div></div>
    </div>
    <div class="col-md-3">
        <div class="card h-100"><div class="card-body">
            <div class="text-muted small">Sách đang mượn</div>
            <div class="fs-4">@Model.OpenLoanItems</div>
        </div></div>
    </div>
    <div class="col-md-3">
        <div class="card h-100"><div class="card-body">
            <div class="text-muted small">Còn nợ</div>
            <div class="fs-4 @(Model.UnpaidTotal > 0 ? "text-danger" : "")">@Money(Model.UnpaidTotal)</div>
        </div></div>
    </div>
</div>

<div class="row g-4 mb-4">
    <div class="col-lg-6">
        <h3 class="h5">Thông tin</h3>
        <table class="table table-sm">
            <tr><th style="width:150px">Điện thoại</th><td>@m.Phone</td></tr>
            <tr><th>Email</th><td>@(m.Email ?? "—")</td></tr>
            <tr><th>Địa chỉ</th><td>@(m.Address ?? "—")</td></tr>
            <tr><th>Ngày sinh</th><td>@(m.DateOfBirth?.ToString("dd/MM/yyyy") ?? "—")</td></tr>
            <tr><th>Ngày tạo hồ sơ</th><td>@m.CreatedAt.ToString("dd/MM/yyyy")</td></tr>
            <tr><th>Tài khoản web</th><td>@(m.User?.Email ?? "Chưa liên kết")</td></tr>
        </table>

        @if (!m.IsLocked)
        {
            <details>
                <summary class="btn btn-sm btn-outline-danger">Khóa khách này</summary>
                <form asp-action="Lock" asp-route-id="@m.Id" method="post" class="mt-2 d-flex gap-2">
                    <input name="reason" class="form-control form-control-sm" placeholder="Lý do khóa (bắt buộc)" maxlength="250" required />
                    <button type="submit" class="btn btn-sm btn-danger text-nowrap">Xác nhận khóa</button>
                </form>
            </details>
        }
    </div>

    <div class="col-lg-6">
        <h3 class="h5">Các thẻ đã mua</h3>
        <table class="table table-sm align-middle">
            <thead><tr><th>Gói</th><th>Hiệu lực</th><th class="text-end">Phí</th><th>Cọc</th><th>Trạng thái</th></tr></thead>
            <tbody>
                @foreach (var c in Model.Memberships)
                {
                    var st = MembershipLabels.Describe(c, today);
                    <tr>
                        <td>@c.Plan?.Name</td>
                        <td class="small">@c.StartDate.ToString("dd/MM/yy") - @c.EndDate.ToString("dd/MM/yy")</td>
                        <td class="text-end">@Money(c.PricePaid)</td>
                        <td class="small">@(c.DepositAmount > 0 ? Money(c.DepositAmount) + " (" + MembershipLabels.Deposit(c.DepositStatus) + ")" : "—")</td>
                        <td><span class="badge text-bg-@st.Badge">@st.Text</span></td>
                    </tr>
                }
                @if (!Model.Memberships.Any())
                {
                    <tr><td colspan="5" class="text-muted text-center py-3">Chưa mua thẻ nào.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>

@if (Model.UnpaidPayments.Any())
{
    <h3 class="h5 text-danger">Khoản còn nợ</h3>
    <table class="table table-sm align-middle mb-4">
        <thead><tr><th>Biên lai</th><th>Ngày</th><th>Loại</th><th class="text-end">Số tiền</th><th>Ghi chú</th><th style="width:320px"></th></tr></thead>
        <tbody>
            @foreach (var p in Model.UnpaidPayments)
            {
                <tr>
                    <td class="font-monospace">@p.ReceiptNo</td>
                    <td>@p.CreatedAt.ToString("dd/MM/yyyy")</td>
                    <td>@PaymentLabels.Type(p.Type)</td>
                    <td class="text-end">@Money(p.Amount)</td>
                    <td class="small text-muted">@p.Note</td>
                    <td>
                        <form asp-controller="Payments" asp-action="Settle" asp-route-id="@p.Id" method="post" class="d-flex gap-2">
                            <select name="method" asp-items="PaymentLabels.MethodOptions(null)" class="form-select form-select-sm"></select>
                            <button type="submit" class="btn btn-sm btn-success text-nowrap">Thu nợ</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

<h3 class="h5">Giao dịch gần đây</h3>
<table class="table table-sm align-middle">
    <thead>
        <tr><th>Biên lai</th><th>Ngày</th><th>Loại</th><th class="text-end">Số tiền</th><th>Hình thức</th><th>Trạng thái</th><th>Ghi chú</th></tr>
    </thead>
    <tbody>
        @foreach (var p in Model.RecentPayments)
        {
            <tr>
                <td class="font-monospace">@p.ReceiptNo</td>
                <td>@p.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                <td>@PaymentLabels.Type(p.Type)</td>
                <td class="text-end @(p.Amount < 0 ? "text-danger" : "")">@Money(p.Amount)</td>
                <td>@PaymentLabels.Method(p.Method)</td>
                <td><span class="badge text-bg-@PaymentLabels.StatusBadge(p.Status)">@PaymentLabels.Status(p.Status)</span></td>
                <td class="small text-muted">@p.Note</td>
            </tr>
        }
        @if (!Model.RecentPayments.Any())
        {
            <tr><td colspan="7" class="text-muted text-center py-3">Chưa có giao dịch.</td></tr>
        }
    </tbody>
</table>
