@model BookFormVm
@{
    ViewData["Title"] = "Thêm sách";
}

<h2 class="h4 mb-3">Thêm sách</h2>

<form asp-action="Create" method="post" enctype="multipart/form-data" style="max-width:820px">
    <partial name="_Form" model="Model" />
    <div class="mt-4">
        <button type="submit" class="btn btn-primary">Lưu</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Hủy</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
