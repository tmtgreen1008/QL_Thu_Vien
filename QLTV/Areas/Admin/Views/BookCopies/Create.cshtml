@model AddCopiesVm
@{
    ViewData["Title"] = "Thêm bản sao";
}

<h2 class="h4 mb-1">Thêm bản sao</h2>
<p class="text-muted">Sách: <a asp-controller="Books" asp-action="Details" asp-route-id="@Model.BookId">@Model.BookTitle</a></p>

<form asp-action="Create" method="post" style="max-width:640px">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <input type="hidden" asp-for="BookId" />

    <div class="row g-3">
        <div class="col-md-4">
            <label asp-for="Quantity" class="form-label"></label>
            <input asp-for="Quantity" type="number" min="1" max="50" class="form-control" />
            <span asp-validation-for="Quantity" class="text-danger"></span>
            <div class="form-text">Mã vạch được tự sinh.</div>
        </div>
        <div class="col-md-8">
            <label asp-for="ShelfLocation" class="form-label"></label>
            <input asp-for="ShelfLocation" class="form-control" placeholder="Ví dụ: Kệ VN-1" />
            <span asp-validation-for="ShelfLocation" class="text-danger"></span>
        </div>
        <div class="col-md-4">
            <label asp-for="Condition" class="form-label"></label>
            <select asp-for="Condition" asp-items="EnumLabels.ConditionOptions(Model.Condition)" class="form-select"></select>
        </div>
        <div class="col-md-4">
            <label asp-for="PurchasePrice" class="form-label"></label>
            <input asp-for="PurchasePrice" type="number" min="0" step="1000" class="form-control" />
            <span asp-validation-for="PurchasePrice" class="text-danger"></span>
        </div>
        <div class="col-md-4">
            <label asp-for="AcquiredDate" class="form-label"></label>
            <input asp-for="AcquiredDate" class="form-control" />
            <span asp-validation-for="AcquiredDate" class="text-danger"></span>
        </div>
        <div class="col-12">
            <div class="form-check">
                <input asp-for="ReadOnSiteOnly" class="form-check-input" />
                <label asp-for="ReadOnSiteOnly" class="form-check-label"></label>
            </div>
        </div>
    </div>

    <div class="mt-4">
        <button type="submit" class="btn btn-primary">Thêm</button>
        <a asp-controller="Books" asp-action="Details" asp-route-id="@Model.BookId" class="btn btn-outline-secondary">Hủy</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
