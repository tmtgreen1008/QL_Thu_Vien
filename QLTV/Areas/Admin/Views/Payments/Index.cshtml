@model PaymentIndexVm
@using System.Globalization
@using LibraryManagement.Areas.Admin.Services
@{
    ViewData["Title"] = "Sổ giao dịch";
    var vi = new CultureInfo("vi-VN");
    string Money(decimal v) => v.ToString("N0", vi) + " đ";
    var returnUrl = Context.Request.Path + Context.Request.QueryString;

    // Luôn truyền dateFrom/dateTo (kể cả rỗng) để phân trang không bị áp lại ngày mặc định
    var pager = new PagerVm { Page = Model.Result.Page, TotalPages = Model.Result.TotalPages };
    pager.RouteValues["dateFrom"] = Model.DateFrom?.ToString("yyyy-MM-dd") ?? "";
    pager.RouteValues["dateTo"] = Model.DateTo?.ToString("yyyy-MM-dd") ?? "";
    if (Model.Type.HasValue) { pager.RouteValues["type"] = ((int)Model.Type.Value).ToString(); }
    if (Model.Method.HasValue) { pager.RouteValues["method"] = ((int)Model.Method.Value).ToString(); }
    if (Model.Status.HasValue) { pager.RouteValues["status"] = ((int)Model.Status.Value).ToString(); }
    if (!string.IsNullOrEmpty(Model.Q)) { pager.RouteValues["q"] = Model.Q; }

    var export = new Dictionary<string, string>(pager.RouteValues);
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="h4 m-0">Sổ giao dịch <span class="text-muted fs-6">(@Model.Result.TotalItems dòng)</span></h2>
    <a asp-action="Export" asp-all-route-data="export" class="btn btn-outline-secondary">Xuất CSV (Excel)</a>
</div>

<form method="get" class="row g-2 mb-3">
    <div class="col-6 col-md-2">
        <label class="form-label small mb-0" for="dateFrom">Từ ngày</label>
        <input type="date" id="dateFrom" name="dateFrom" value="@(Model.DateFrom?.ToString("yyyy-MM-dd"))" class="form-control" />
    </div>
    <div class="col-6 col-md-2">
        <label class="form-label small mb-0" for="dateTo">Đến ngày</label>
        <input type="date" id="dateTo" name="dateTo" value="@(Model.DateTo?.ToString("yyyy-MM-dd"))" class="form-control" />
    </div>
    <div class="col-6 col-md-2">
        <label class="form-label small mb-0" for="type">Loại khoản thu</label>
        <select id="type" name="type" class="form-select">
            <option value="">Tất cả</option>
            @foreach (var o in PaymentFilterOptions.Types(Model.Type)) { <option value="@o.Value" selected="@o.Selected">@o.Text</option> }
        </select>
    </div>
    <div class="col-6 col-md-2">
        <label class="form-label small mb-0" for="method">Hình thức</label>
        <select id="method" name="method" class="form-select">
            <option value="">Tất cả</option>
            @foreach (var o in PaymentFilterOptions.Methods(Model.Method)) { <option value="@o.Value" selected="@o.Selected">@o.Text</option> }
        </select>
    </div>
    <div class="col-6 col-md-2">
        <label class="form-label small mb-0" for="status">Trạng thái</label>
        <select id="status" name="status" class="form-select">
            <option value="">Tất cả</option>
            @foreach (var o in PaymentFilterOptions.Statuses(Model.Status)) { <option value="@o.Value" selected="@o.Selected">@o.Text</option> }
        </select>
    </div>
    <div class="col-6 col-md-2">
        <label class="form-label small mb-0" for="q">Biên lai / khách</label>
        <input id="q" name="q" value="@Model.Q" class="form-control" placeholder="PT000003, tên, SĐT..." />
    </div>
    <div class="col-12">
        <button type="submit" class="btn btn-outline-secondary">Lọc</button>
        <a asp-action="Index" class="btn btn-link">Về mặc định (tháng này)</a>
    </div>
</form>

<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card h-100"><div class="card-body">
            <div class="text-muted small">Doanh thu (đã thu, không gồm cọc)</div>
            <div class="fs-4">@Money(Model.Revenue)</div>
        </div></div>
    </div>
    <div class="col-md-3">
        <div class="card h-100"><div class="card-body">
            <div class="text-muted small">Cọc ròng (thu cọc − hoàn cọc)</div>
            <div class="fs-4">@Money(Model.DepositNet)</div>
        </div></div>
    </div>
    <div class="col-md-3">
        <div class="card h-100"><div class="card-body">
            <div class="text-muted small">Còn nợ</div>
            <div class="fs-4 @(Model.UnpaidTotal > 0 ? "text-danger" : "")">@Money(Model.UnpaidTotal)</div>
        </div></div>
    </div>
    <div class="col-md-3">
        <div class="card h-100"><div class="card-body">
            <div class="text-muted small">Giao dịch đã hủy</div>
            <div class="fs-4">@Model.VoidedCount</div>
        </div></div>
    </div>
</div>

<table class="table table-hover align-middle">
    <thead>
        <tr>
            <th>Biên lai</th>
            <th>Ngày</th>
            <th>Khách</th>
            <th>Loại</th>
            <th class="text-end">Số tiền</th>
            <th>Hình thức</th>
            <th>Trạng thái</th>
            <th>Người thu</th>
            <th>Ghi chú</th>
            <th style="width:130px"></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var r in Model.Result.Items)
        {
            var voided = r.Status == LibraryManagement.Models.Enums.PaymentStatus.Voided;
            <tr class="@(voided ? "text-muted" : "")">
                <td class="font-monospace @(voided ? "text-decoration-line-through" : "")">@r.ReceiptNo</td>
                <td class="small">@r.When.ToString("dd/MM/yyyy HH:mm")</td>
                <td>
                    @if (r.MemberId.HasValue)
                    {
                        <a asp-controller="Members" asp-action="Details" asp-route-id="@r.MemberId" class="text-decoration-none">@r.MemberName</a>
                        <div class="small text-muted font-monospace">@r.MemberCode</div>
                    }
                    else { <span class="text-muted">—</span> }
                </td>
                <td>@PaymentLabels.Type(r.Type)</td>
                <td class="text-end @(r.Amount < 0 ? "text-danger" : "") @(voided ? "text-decoration-line-through" : "")">@Money(r.Amount)</td>
                <td>@PaymentLabels.Method(r.Method)</td>
                <td><span class="badge text-bg-@PaymentLabels.StatusBadge(r.Status)">@PaymentLabels.Status(r.Status)</span></td>
                <td class="small">@r.ReceivedByName</td>
                <td class="small text-muted">
                    @r.Note
                    @if (voided && !string.IsNullOrEmpty(r.VoidReason)) { <div class="text-danger">Hủy: @r.VoidReason</div> }
                </td>
                <td class="text-end">
                    @if (!voided && PaymentRules.CanVoid(r.Type))
                    {
                        <details>
                            <summary class="btn btn-sm btn-outline-danger">Hủy</summary>
                            <form asp-action="Void" asp-route-id="@r.Id" method="post" class="mt-2" style="min-width:220px">
                                <input type="hidden" name="returnUrl" value="@returnUrl" />
                                <input name="reason" class="form-control form-control-sm mb-1" placeholder="Lý do hủy (bắt buộc)" maxlength="150" required minlength="5" />
                                <button type="submit" class="btn btn-sm btn-danger w-100"
                                        onclick="return confirm('Hủy giao dịch này? Không thể hoàn tác.');">Xác nhận hủy</button>
                            </form>
                        </details>
                    }
                </td>
            </tr>
        }
        @if (!Model.Result.Items.Any())
        {
            <tr><td colspan="10" class="text-center text-muted py-4">Không có giao dịch nào trong khoảng này.</td></tr>
        }
    </tbody>
</table>

<partial name="_Pager" model="pager" />

<p class="text-muted small">Phí thẻ, tiền cọc và hoàn cọc gắn với thẻ nên không hủy trực tiếp: dùng "Hoàn cọc, hủy thẻ" ở hồ sơ khách.
Khoản phạt, phí thuê, tiền đền có thể hủy (ví dụ miễn phạt) nhưng phải ghi lý do, dòng giao dịch vẫn được giữ lại.</p>
