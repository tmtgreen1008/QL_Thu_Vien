@model ExpiringVm
@{
    ViewData["Title"] = "Thẻ sắp hết hạn";
    ViewData["Tab"] = "expiring";
    var today = DateTime.Today;
}

<h2 class="h4 mb-3">Báo cáo</h2>
<partial name="_ReportNav" />

<form method="get" class="row g-2 mb-4 align-items-end">
    <div class="col-6 col-md-3">
        <label class="form-label small mb-0" for="days">Sắp hết hạn trong (ngày)</label>
        <input type="number" id="days" name="days" value="@Model.Days" min="1" max="90" class="form-control" />
    </div>
    <div class="col-auto"><button type="submit" class="btn btn-outline-secondary">Xem</button></div>
</form>

<h3 class="h5">Sắp hết hạn trong @Model.Days ngày tới <span class="text-muted fs-6">(@Model.Expiring.Count)</span></h3>
<table class="table table-hover align-middle mb-4">
    <thead><tr><th>Mã</th><th>Khách</th><th>Điện thoại</th><th>Hết hạn</th><th class="text-center">Còn lại</th><th style="width:120px"></th></tr></thead>
    <tbody>
        @foreach (var r in Model.Expiring)
        {
            var left = (r.EndDate.Date - today).Days;
            <tr>
                <td class="font-monospace">@r.MemberCode</td>
                <td>@r.FullName @if (r.IsLocked) { <span class="badge text-bg-danger ms-1">Đã khóa</span> }</td>
                <td>@r.Phone</td>
                <td>@r.EndDate.ToString("dd/MM/yyyy")</td>
                <td class="text-center"><span class="badge text-bg-@(left <= 3 ? "danger" : "warning")">@(left == 0 ? "Hôm nay" : left + " ngày")</span></td>
                <td class="text-end"><a asp-controller="Memberships" asp-action="Sell" asp-route-memberId="@r.MemberId" class="btn btn-sm btn-success">Gia hạn</a></td>
            </tr>
        }
        @if (!Model.Expiring.Any())
        {
            <tr><td colspan="6" class="text-center text-muted py-3">Không có thẻ nào sắp hết hạn.</td></tr>
        }
    </tbody>
</table>

<h3 class="h5">Đã hết hạn trong 30 ngày qua <span class="text-muted fs-6">(@Model.RecentlyExpired.Count)</span></h3>
<table class="table table-hover align-middle">
    <thead><tr><th>Mã</th><th>Khách</th><th>Điện thoại</th><th>Hết hạn từ</th><th style="width:120px"></th></tr></thead>
    <tbody>
        @foreach (var r in Model.RecentlyExpired)
        {
            <tr>
                <td class="font-monospace">@r.MemberCode</td>
                <td>@r.FullName</td>
                <td>@r.Phone</td>
                <td>@r.EndDate.ToString("dd/MM/yyyy") <span class="text-muted small">(@((today - r.EndDate.Date).Days) ngày trước)</span></td>
                <td class="text-end"><a asp-controller="Memberships" asp-action="Sell" asp-route-memberId="@r.MemberId" class="btn btn-sm btn-outline-success">Gia hạn</a></td>
            </tr>
        }
        @if (!Model.RecentlyExpired.Any())
        {
            <tr><td colspan="5" class="text-center text-muted py-3">Không có.</td></tr>
        }
    </tbody>
</table>
