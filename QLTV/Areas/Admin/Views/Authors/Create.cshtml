@model Author
@{
    ViewData["Title"] = "Thêm tác giả";
}

<h2 class="h4 mb-3">Thêm tác giả</h2>

<form asp-action="Create" method="post" style="max-width:640px">
    <partial name="_Form" model="Model" />
    <button type="submit" class="btn btn-primary">Lưu</button>
    <a asp-action="Index" class="btn btn-outline-secondary">Hủy</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
