@model MembershipPlan
@{
    ViewData["Title"] = "Sửa gói thành viên";
}

<h2 class="h4 mb-3">Sửa gói thành viên</h2>

<form asp-action="Edit" asp-route-id="@Model.Id" method="post" style="max-width:720px">
    <partial name="_Form" model="Model" />
    <div class="mt-4">
        <button type="submit" class="btn btn-primary">Cập nhật</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Hủy</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
