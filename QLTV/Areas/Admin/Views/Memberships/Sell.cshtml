@model SellMembershipVm
@using System.Globalization
@{
    ViewData["Title"] = "Bán / gia hạn thẻ";
    var vi = new CultureInfo("vi-VN");
    string Money(decimal v) => v.ToString("N0", vi) + " đ";
}

<h2 class="h4 mb-1">@(Model.IsRenewal ? "Gia hạn thẻ" : "Bán thẻ")</h2>
<p class="text-muted">
    Khách: <a asp-controller="Members" asp-action="Details" asp-route-id="@Model.MemberId">@Model.MemberName</a>
    <span class="font-monospace">(@Model.MemberCode)</span>
</p>

@if (Model.IsRenewal)
{
    <div class="alert alert-info">Khách đang có thẻ còn hạn. Thẻ mới có hiệu lực từ <strong>@Model.StartDate.ToString("dd/MM/yyyy")</strong>, ngay sau khi thẻ hiện tại hết hạn.</div>
}
@if (!Model.NeedsDeposit)
{
    <div class="alert alert-secondary">Khách đang giữ tiền cọc nên <strong>không thu cọc lần nữa</strong>.</div>
}

<form asp-action="Sell" method="post" style="max-width:960px">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <input type="hidden" asp-for="MemberId" />

    <table class="table table-hover align-middle">
        <thead>
            <tr>
                <th style="width:40px"></th>
                <th>Gói</th>
                <th class="text-center">Thời hạn</th>
                <th class="text-center">Sách tối đa</th>
                <th class="text-center">Ngày mượn</th>
                <th class="text-center">Gia hạn</th>
                <th class="text-end">Phí</th>
                <th class="text-end">Cọc</th>
                <th class="text-end">Tổng thu</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var p in Model.Plans)
            {
                var deposit = Model.NeedsDeposit ? p.DepositAmount : 0;
                <tr>
                    <td><input type="radio" asp-for="PlanId" value="@p.Id" class="form-check-input" id="plan_@p.Id" /></td>
                    <td><label for="plan_@p.Id" class="fw-semibold">@p.Name</label></td>
                    <td class="text-center">@p.DurationMonths tháng</td>
                    <td class="text-center">@p.MaxBooks</td>
                    <td class="text-center">@p.LoanDays</td>
                    <td class="text-center">@p.MaxRenewals</td>
                    <td class="text-end">@Money(p.Price)</td>
                    <td class="text-end">@(deposit > 0 ? Money(deposit) : "—")</td>
                    <td class="text-end fw-semibold">@Money(p.Price + deposit)</td>
                </tr>
            }
            @if (!Model.Plans.Any())
            {
                <tr><td colspan="9" class="text-center text-muted py-4">Chưa có gói nào đang bán. Hãy tạo gói trong mục Gói thành viên.</td></tr>
            }
        </tbody>
    </table>
    <span asp-validation-for="PlanId" class="text-danger"></span>

    <div class="row g-3 mt-1">
        <div class="col-md-4">
            <label asp-for="Method" class="form-label"></label>
            <select asp-for="Method" asp-items="PaymentLabels.MethodOptions(Model.Method)" class="form-select"></select>
        </div>
        <div class="col-md-8">
            <label asp-for="Note" class="form-label"></label>
            <input asp-for="Note" class="form-control" />
            <span asp-validation-for="Note" class="text-danger"></span>
        </div>
    </div>

    <div class="mt-4">
        <button type="submit" class="btn btn-success" onclick="return confirm('Xác nhận đã thu tiền và tạo thẻ?');">Xác nhận thu tiền</button>
        <a asp-controller="Members" asp-action="Details" asp-route-id="@Model.MemberId" class="btn btn-outline-secondary">Hủy</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
