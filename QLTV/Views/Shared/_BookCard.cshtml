@model BookCardVm
<div class="card book-card h-100">
    <a asp-controller="Catalog" asp-action="Details" asp-route-id="@Model.Id" class="book-cover" aria-label="@Model.Title">
        @if (!string.IsNullOrEmpty(Model.CoverImagePath))
        {
            <img src="@Model.CoverImagePath" alt="@T["book.cover.alt", Model.Title]" loading="lazy" />
        }
        else
        {
            <div class="cover-placeholder" style="background:hsl(@(Model.Id * 47 % 360), 50%, 48%)">
                @(Model.Title.Length > 0 ? Model.Title[0].ToString().ToUpper() : "?")
            </div>
        }
    </a>
    <div class="card-body pb-2">
        <div class="small text-muted">@Model.Category</div>
        <h3 class="card-title h6 mb-1"><a asp-controller="Catalog" asp-action="Details" asp-route-id="@Model.Id">@Model.Title</a></h3>
        <div class="small text-muted">@Model.Author</div>
    </div>
    <div class="card-footer bg-transparent border-0 pt-0 pb-3">
        @if (Model.Borrowable > 0)
        {
            <span class="badge text-bg-success">@T["book.available", Model.Borrowable]</span>
        }
        else if (Model.ReadOnSite > 0)
        {
            <span class="badge text-bg-info">@T["book.onsite"]</span>
        }
        else
        {
            <span class="badge text-bg-secondary">@T["book.unavailable"]</span>
        }
    </div>
</div>
