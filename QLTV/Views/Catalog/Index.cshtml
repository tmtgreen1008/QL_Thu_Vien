@model CatalogIndexVm
@{
    ViewData["Title"] = T["catalog.title"];
    var pager = new PagerVm { Page = Model.Result.Page, TotalPages = Model.Result.TotalPages };
    if (!string.IsNullOrEmpty(Model.Q)) { pager.RouteValues["q"] = Model.Q; }
    if (Model.CategoryId.HasValue) { pager.RouteValues["categoryId"] = Model.CategoryId.Value.ToString(); }
    if (Model.AvailableOnly) { pager.RouteValues["availableOnly"] = "true"; }
    pager.RouteValues["sort"] = Model.Sort;
}

<h1 class="h3 section-title mb-3">@T["catalog.title"]</h1>

<form method="get" id="catalogForm" class="row g-2 align-items-end mb-4 bg-white p-3 rounded-3 shadow-sm">
    <div class="col-md-4">
        <label class="form-label small mb-0" for="q">@T["catalog.keyword"]</label>
        <input id="q" name="q" value="@Model.Q" class="form-control" placeholder="@T["catalog.keyword.ph"]" autocomplete="off" />
    </div>
    <div class="col-md-3">
        <label class="form-label small mb-0" for="categoryId">@T["catalog.category"]</label>
        <select id="categoryId" name="categoryId" class="form-select">
            <option value="">@T["catalog.category.all"]</option>
            @foreach (var c in Model.Categories) { <option value="@c.Value" selected="@c.Selected">@c.Text</option> }
        </select>
    </div>
    <div class="col-md-2">
        <label class="form-label small mb-0" for="sort">@T["catalog.sort"]</label>
        <select id="sort" name="sort" class="form-select">
            <option value="title" selected="@(Model.Sort == "title")">@T["catalog.sort.title"]</option>
            <option value="new" selected="@(Model.Sort == "new")">@T["catalog.sort.new"]</option>
        </select>
    </div>
    <div class="col-md-2">
        <div class="form-check mb-2">
            <input class="form-check-input" type="checkbox" id="availableOnly" name="availableOnly" value="true" checked="@Model.AvailableOnly" />
            <label class="form-check-label small" for="availableOnly">@T["catalog.availableOnly"]</label>
        </div>
    </div>
    <div class="col-md-1 d-grid"><button type="submit" class="btn btn-primary">@T["catalog.filter"]</button></div>
</form>

<p class="text-muted">@T["catalog.found.prefix"] <strong id="resultCount">@Model.Result.TotalItems.ToString("N0")</strong> @T["catalog.found.suffix"]
    @if (!string.IsNullOrEmpty(Model.Q) || Model.CategoryId.HasValue || Model.AvailableOnly)
    {
        <a asp-action="Index" class="ms-2">@T["catalog.clear"]</a>
    }
</p>

<div id="emptyMsg" class="text-center text-muted py-5 @(Model.Result.Items.Any() ? "d-none" : "")">
    @T["catalog.empty"]
</div>

<div id="bookGrid" class="row row-cols-2 row-cols-md-3 row-cols-lg-4 g-3 mb-4">
    @foreach (var b in Model.Result.Items)
    {
        <div class="col"><partial name="_BookCard" model="b" /></div>
    }
</div>

<div class="text-center mb-4">
    <button type="button" id="loadMore" class="btn btn-outline-primary d-none">@T["catalog.more"]</button>
</div>

<div id="serverPager"><partial name="_Pager" model="pager" /></div>

@section Scripts {
    <script>
        // Chuỗi giao diện cho JavaScript (theo ngôn ngữ đang chọn)
        window.I18N = @Json.Serialize(new
        {
            available = T["book.available"],
            onsite = T["book.onsite"],
            unavailable = T["book.unavailable"],
            coverAlt = T["book.cover.alt"],
            error = T["catalog.error"]
        });
    </script>
    <script src="~/js/catalog.js" asp-append-version="true"></script>
}
